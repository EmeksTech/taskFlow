generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum PersonalAccessTokenScope {
  TASKS_READ  @map("tasks:read")
  TASKS_WRITE @map("tasks:write")
  PROFILE_READ @map("profile:read")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique @db.VarChar(320)
  passwordHash String?
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tasks                 Task[]
  personalAccessTokens PersonalAccessToken[]
}

model Task {
  id           String       @id @default(uuid()) @db.Uuid
  title        String       @db.VarChar(200)
  description  String       @default("") @db.Text
  category     String       @default("") @db.VarChar(100)
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(PENDING)
  dueDate      DateTime?    @db.Date
  assigneeName String?      @db.VarChar(120)
  ownerId      String?      @db.Uuid
  owner        User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([ownerId])
  @@index([status, dueDate])
}

model PersonalAccessToken {
  id         String                      @id @default(uuid()) @db.Uuid
  userId     String                      @db.Uuid
  name       String                      @db.VarChar(100)
  tokenHash  String                      @unique @db.Char(64)
  tokenPrefix String                     @db.VarChar(24)
  scopes     PersonalAccessTokenScope[]
  createdAt  DateTime                    @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  user       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuthRateLimit {
  key             String   @id @db.VarChar(64)
  attempts        Int      @default(0)
  windowStartedAt DateTime @db.Timestamptz(3)

  @@index([windowStartedAt])
}
