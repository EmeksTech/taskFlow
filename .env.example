NEXT_PUBLIC_API_MODE=database

# Neon pooled runtime connection URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Neon direct (non-pooler) connection URL for controlled migration runs only.
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Generate a random secret locally; never commit the real value.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Trust the hosting platform's forwarded host header (Vercel/Render).
AUTH_TRUST_HOST=true

# Only used when NEXT_PUBLIC_API_MODE=mock.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Optional exact origins for an explicitly trusted classroom proxy.
# Leave unset unless the API should accept writes from that origin.
# Do not use wildcards. Production does not trust development origins by default.
# TASKFLOW_ALLOWED_ORIGINS=http://localhost:5173
