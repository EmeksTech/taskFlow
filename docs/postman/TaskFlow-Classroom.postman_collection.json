            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Bearer task lookup returns the created record', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(pm.environment.get('bearerTaskId')); });"
                ]
              }
            }
          ]
        },
