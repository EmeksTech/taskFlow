    },
    {
      "name": "D - Bearer API",
      "description": "Use tokens created in TaskFlow Settings. Set accessToken to a secret token with profile:read, tasks:read, and tasks:write; set readOnlyAccessToken to a separate tasks:read token. Ownership checks also require Account B's token and a task created by Account B. Defaults target the local backend.",
      "item": [
        {
          "name": "GET - Current token owner",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile endpoint returns safe owner fields', function () { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body).to.have.property('id'); pm.expect(body).to.have.property('email'); pm.expect(body).not.to.have.property('passwordHash'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Search, filter, and paginate Bearer tasks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks?page={{page}}&limit={{limit}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"],
              "query": [
                { "key": "page", "value": "{{page}}" },
                { "key": "limit", "value": "{{limit}}" }
              ]
            },
            "description": "Optional filters are read from the environment: search, status, priority, assignee, dueAfter, and dueBefore."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.url.query.clear();",
                  "['search', 'status', 'priority', 'assignee', 'dueAfter', 'dueBefore', 'page', 'limit'].forEach(function (key) { const value = pm.environment.get(key); if (value !== undefined && value !== null && String(value).trim() !== '') pm.request.url.query.add({ key: key, value: String(value) }); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Bearer task list returns the paginated envelope', function () { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body.tasks).to.be.an('array'); ['page', 'limit', 'total', 'totalPages'].forEach(function (key) { pm.expect(body).to.have.property(key); }); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - Create Bearer task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Bearer task\",\n  \"description\": \"Disposable task created by the local Postman collection\",\n  \"assignee\": \"Classroom Student\",\n  \"category\": \"Training\",\n  \"priority\": \"High\",\n  \"status\": \"Pending\",\n  \"dueDate\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Bearer task creation returns 201', function () { pm.response.to.have.status(201); });",
                  "const task = pm.response.json();",
                  "pm.expect(task).to.have.property('id');",
                  "pm.environment.set('bearerTaskId', task.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Retrieve Bearer task",
          "request": {
            "method": "GET",
            "header": [
