            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            },
            "description": "The empty patch would fail validation if origin validation were skipped, so it cannot change task data."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Untrusted Origin is rejected before payload validation', function () { pm.response.to.have.status(403); pm.expect(pm.response.json().error.code).to.eql('INVALID_ORIGIN'); });"
                ]
              }
            }
          ]
