{
  "info": {
    "_postman_id": "56ec425f-2acd-4a58-a3b6-a68d6e1d7ec1",
    "name": "TaskFlow Classroom API",
    "description": "Auth.js Credentials, owner-scoped tasks, and Bearer API checks. Defaults to the local TaskFlow backend at localhost:3100. Set secrets only in the local Postman environment and use disposable test accounts and tasks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3100" },
    { "key": "apiOrigin", "value": "http://localhost:3100" },
    { "key": "callbackUrl", "value": "http://localhost:3100/" },
    { "key": "csrfToken", "value": "" },
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "A - Authentication",
      "item": [
        {
          "name": "Register student account",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Origin", "value": "{{apiOrigin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{registrationName}}\",\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"{{registrationPassword}}\",\n  \"confirmPassword\": \"{{registrationConfirmPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/register",
            "description": "Creates an account on the selected TaskFlow backend. Store test credentials only in the local Postman environment. Registration does not sign in or issue a personal access token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration returns 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Only public user fields are returned', function () { const body = pm.response.json(); pm.expect(body).to.have.property('id'); pm.expect(body).to.have.property('email'); pm.expect(body).not.to.have.property('password'); pm.expect(body).not.to.have.property('passwordHash'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get authentication providers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/providers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "providers"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Providers endpoint returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Credentials provider is available', function () { pm.expect(pm.response.json()).to.have.property('credentials'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get CSRF token",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/csrf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "csrf"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF endpoint returns 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.csrfToken).to.be.a('string').and.not.empty;",
                  "pm.environment.set('csrfToken', body.csrfToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in with Credentials",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "X-Auth-Return-Redirect", "value": "1" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "csrfToken", "value": "{{csrfToken}}", "type": "text" },
                { "key": "callbackUrl", "value": "{{callbackUrl}}", "type": "text" },
                { "key": "email", "value": "{{email}}", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/callback/credentials",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "callback", "credentials"]
            },
            "description": "Populate email and password as local-only Postman environment secrets. Run Get CSRF token first. Postman retains the returned Auth.js cookies in its cookie jar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Credentials callback returns JSON redirect data', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().url).to.be.a('string'); });",
                  "pm.test('Credentials were accepted', function () { pm.expect(pm.response.json().url).not.to.include('error='); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current session",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "session"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Session endpoint returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Session exposes public user fields only', function () { const body = pm.response.json(); pm.expect(body.user).to.be.an('object'); pm.expect(body.user).to.have.property('id'); pm.expect(body.user).to.have.property('email'); pm.expect(body.user).not.to.have.property('passwordHash'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign out",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "X-Auth-Return-Redirect", "value": "1" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "csrfToken", "value": "{{csrfToken}}", "type": "text" },
                { "key": "callbackUrl", "value": "{{callbackUrl}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signout"]
            },
            "description": "Run Get CSRF token immediately before this request. Cookies stay in Postman's cookie jar and are not copied into variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sign-out returns redirect data', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().url).to.be.a('string'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "B - Tasks",
      "description": "Use a dedicated test account. Create and delete only a disposable classroom task.",
      "item": [
        {
          "name": "GET - List my tasks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Task list returns 200 and an array', function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Search, filter, and paginate tasks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/tasks",
            "description": "Uses the Auth.js cookie session. Set any optional environment filters: search, status, priority, assignee, dueAfter, dueBefore. Pagination returns tasks, page, limit, total, and totalPages."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.url.query.clear();",
                  "['search', 'status', 'priority', 'assignee', 'dueAfter', 'dueBefore', 'page', 'limit'].forEach(function (key) { const value = pm.environment.get(key); if (value !== undefined && value !== null && String(value).trim() !== '') pm.request.url.query.add({ key: key, value: String(value) }); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Filtered task list returns a paginated envelope', function () { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body.tasks).to.be.an('array'); pm.expect(body).to.have.property('page'); pm.expect(body).to.have.property('limit'); pm.expect(body).to.have.property('total'); pm.expect(body).to.have.property('totalPages'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - Create disposable task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Origin",
                "value": "{{apiOrigin}}",
                "description": "For this explicit Postman client request, set the actual API origin. Do not rewrite browser Origin headers."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Learn REST API with Postman\",\n  \"description\": \"Disposable TaskFlow classroom test record\",\n  \"status\": \"Pending\",\n  \"priority\": \"High\",\n  \"assignee\": \"Classroom Student\",\n  \"category\": \"Training\",\n  \"dueDate\": \"2026-11-18\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            },
            "description": "Creates a real database record in database mode. Use only a dedicated classroom account."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Task creation returns 201', function () { pm.response.to.have.status(201); });",
                  "const task = pm.response.json();",
                  "pm.expect(task).to.have.property('id');",
                  "pm.expect(task.title).to.eql('Learn REST API with Postman');",
                  "pm.environment.set('taskId', task.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Retrieve task by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Task lookup returns the created record', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(pm.environment.get('taskId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH - Update disposable task",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Origin", "value": "{{apiOrigin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated through Postman\",\n  \"status\": \"In Progress\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Task update returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json().title).to.eql('Updated through Postman');"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE - Delete disposable task (DESTRUCTIVE)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Origin", "value": "{{apiOrigin}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            },
            "description": "Permanently deletes taskId. Run only after creating a disposable task for this test."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Task delete returns 204 with no body', function () { pm.response.to.have.status(204); pm.expect(pm.response.text()).to.eql(''); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "C - Security tests",
      "description": "Use two dedicated test users. Sign out before the unauthenticated request. Account B must not access Account A's disposable task.",
      "item": [
        {
          "name": "Auth.js - Invalid credentials are rejected",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "X-Auth-Return-Redirect", "value": "1" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "csrfToken", "value": "{{csrfToken}}", "type": "text" },
                { "key": "callbackUrl", "value": "{{callbackUrl}}", "type": "text" },
                { "key": "email", "value": "invalid@example.invalid", "type": "text" },
                { "key": "password", "value": "not-a-valid-classroom-password", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/callback/credentials",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "callback", "credentials"]
            },
            "description": "Run only against local/preview or with instructor approval. This consumes one login rate-limit attempt and must return a generic CredentialsSignin error."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid credentials are rejected without account details', function () { pm.expect(pm.response.json().url).to.include('error='); pm.expect(pm.response.json().url).not.to.include('invalid@example.invalid'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Auth.js - Missing CSRF token is rejected",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "X-Auth-Return-Redirect", "value": "1" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "callbackUrl", "value": "{{callbackUrl}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/callback/credentials",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "callback", "credentials"]
            },
            "description": "No credentials or task mutation is attempted. Auth.js must reject the missing CSRF token before credential authorization."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing CSRF is rejected by Auth.js', function () { pm.expect(pm.response.json().url).to.include('error='); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Auth.js - Invalid CSRF token is rejected",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "X-Auth-Return-Redirect", "value": "1" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "csrfToken", "value": "invalid-classroom-token", "type": "text" },
